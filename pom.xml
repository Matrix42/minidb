<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.minidb</groupId>
  <artifactId>minidb-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>minidb-parser</module>
    <module>minidb-storage</module>
    <module>minidb-protocol</module>
    <module>minidb-server</module>
    <module>minidb-jdbc</module>
    <module>minidb-integration-tests</module>
    <module>minidb-tpcds</module>
    <module>minidb-dist</module>
  </modules>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <netty.version>4.1.137.Final</netty.version>
    <arrow.version>19.0.0</arrow.version>
    <calcite.version>1.42.0</calcite.version>
    <junit.version>5.14.4</junit.version>
    <log4j.version>2.24.3</log4j.version>
    <sqlline.version>1.12.0</sqlline.version>
    <spotless.version>2.43.0</spotless.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-all</artifactId>
        <version>${netty.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-vector</artifactId>
        <version>${arrow.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-algorithm</artifactId>
        <version>${arrow.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-memory-core</artifactId>
        <version>${arrow.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-memory-netty</artifactId>
        <version>${arrow.version}</version>
        <scope>runtime</scope>
        <exclusions>
          <exclusion>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-unsafe</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.apache.calcite</groupId>
        <artifactId>calcite-core</artifactId>
        <version>${calcite.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.calcite</groupId>
        <artifactId>calcite-server</artifactId>
        <version>${calcite.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j2-impl</artifactId>
        <version>${log4j.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-parser</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-arrow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-parquet</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-lsm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-protocol</artifactId>
        <version>${project.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-unsafe</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.minidb</groupId>
        <artifactId>minidb-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>sqlline</groupId>
        <artifactId>sqlline</artifactId>
        <version>${sqlline.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <!-- 固定 LF,避免 Windows(CRLF)与 CI/Linux(LF)下 spotless 检查结果不一致 -->
          <lineEndings>UNIX</lineEndings>
          <java>
            <googleJavaFormat>
              <version>1.24.0</version>
              <style>AOSP</style>
            </googleJavaFormat>

            <!-- import 分组:本工程 → 其余第三方 → javax → java → 静态导入 -->
            <importOrder>
              <order>com.minidb,,javax,java,\#</order>
            </importOrder>

            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
